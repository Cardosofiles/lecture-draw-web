# O contrato abaixo é validado por `src/shared/env/index.ts` (zod + @t3-oss/env-nextjs)
# no boot da aplicação. Faltando ou malformada, a app não sobe e o erro nomeia a
# variável — em vez de virar um 500 no meio do login.

# PostgreSQL connection string.
#
# Produção: Neon (https://neon.tech → Project → Connection String).
# Local:    `docker compose up -d` e use a linha comentada abaixo.
#           A porta do host é 5433 (ver docker-compose.yml).
# DATABASE_URL="postgresql://lecture:lecture@localhost:5433/lecture_draw"
DATABASE_URL=

# Better Auth secret — mínimo 32 caracteres.
# Gere com: openssl rand -base64 32
# Trocar este valor invalida toda sessão já emitida.
BETTER_AUTH_SECRET=

# Origem pública da aplicação, sem barra no final.
#
# É daqui que sai o `redirect_uri` mandado ao Google e ao GitHub: precisa bater
# exatamente com o que está cadastrado no console de cada provedor. Em produção
# (Vercel) é o domínio do deploy — https://seu-app.vercel.app —, nunca localhost.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials
# Create at: https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mesma origem de BETTER_AUTH_URL, exposta ao browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin email — this email will be promoted to admin role on seed
ADMIN_EMAIL=

# Opcional. Origem canônica para SEO (canonical, og:url, sitemap).
# Ausente, cai em NEXT_PUBLIC_APP_URL.
# SITE_URL=

# Opcional. `true` pula a validação do schema de env — só para etapas de build
# que não têm segredos (lint no CI, build de imagem Docker).
# SKIP_ENV_VALIDATION=true
