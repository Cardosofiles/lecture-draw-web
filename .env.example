# PostgreSQL connection string.
#
# Produção: Neon (https://neon.tech → Project → Connection String).
# Local:    `docker compose up -d` e use a linha comentada abaixo.
#           A porta do host é 5433 (ver docker-compose.yml).
# DATABASE_URL="postgresql://lecture:lecture@localhost:5433/lecture_draw"
DATABASE_URL=

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of your app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth credentials
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials
# Create at: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public app URL (used in client-side code)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin email — this email will be promoted to admin role on seed
ADMIN_EMAIL=
